{
  "Resources": {
    "Bucket": {
      "Type": "AWS::S3::Bucket",
      "Properties": {
        "BucketName": "my-bucket",
        "VersioningConfiguration": {
          "Status": "Enabled",
          "Fn::Transform": {
            "Name": "AWS::Include",
            "Parameters": {
              "Location": "s3://my-snippets/versioning.yaml"
            }
          }
        },
        "Fn::Transform": {
          "Name": "AWS::Include",
          "Parameters": {
            "Location": "s3://my-snippets/bucket.yaml"
          }
        }
      }
    },
    "Topic": {
      "Type": "AWS::SNS::Topic",
      "Properties": {
        "TopicName": "my-topic",
        "Fn::Transform": {
          "Name": "AWS::Include",
          "Parameters": {
            "Location": "s3://my-snippets/topic.yaml"
          }
        }
      }
    }
  }
}
